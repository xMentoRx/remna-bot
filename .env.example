# ==========================================
# 🤖 REMNA-BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Telegram Bot Token from @BotFather (REQUIRED)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Admin User IDs allowed to access bot (comma-separated integers)
ADMIN_CHAT_IDS=123456789,987654321

# Monitoring & Alert Supergroup Chat ID (Optional)
ALERT_CHAT_ID=-1001234567890

# Forum Supergroup Topic / Thread ID for Node Uptime Alerts (Optional, default 0)
ALERT_TOPIC_ID=2

# Forum Supergroup Topic / Thread ID for Subscription Sharing & HWID Leak Alerts (Optional, default 0)
SHARING_ALERT_TOPIC_ID=3

# Forum Supergroup Topic / Thread ID for Daily PostgreSQL Database Backups (Optional, default 0)
BACKUP_ALERT_TOPIC_ID=4

# Initial Remnawave Panel REST API URL (Optional, can be set via MiniApp)
API_URL=https://panel.mydomain.com

# Initial Remnawave Bearer Token (Optional, can be set via MiniApp)
API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram MiniApp Server Settings
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
